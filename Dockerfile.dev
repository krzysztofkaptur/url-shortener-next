ARG NODE_VERSION=24.13.0-slim
FROM node:${NODE_VERSION}

WORKDIR /app

# Lets pnpm recreate the node_modules volume without prompting (no TTY in the container)
ENV CI=true

RUN corepack enable pnpm && pnpm config set package-import-method copy

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

EXPOSE 3000

# Syncs the node_modules volume with the lockfile on every start, so new packages appear without manual steps
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm dev --hostname 0.0.0.0 --port 3000"]
